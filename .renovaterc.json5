{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  env: {
    MISE_TRUSTED_CONFIG_PATHS: './',
  },
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'helpers:pinGitHubActionDigestsToSemver',
    ':dependencyDashboard',
    ':disableRateLimiting',
  ],
  dependencyDashboard: {
    title: 'Renovate Dashboard 🤖',
  },
  postUpdateOptions: [
    'gomodTidy',
    'gomodUpdateImportPaths',
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 3am on the first day of the month',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Process annotated dependencies',
      managerFilePatterns: [
        '/\\.env(?:\\.j2)?$/',
        '/\\.sh(?:\\.j2)?$/',
        '/\\.yaml(?:\\.j2)?$/',
        '/^\\.custom-gcl\\.yml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+(:\\s|=)(&\\S+\\s)?["\']?(?<currentValue>[^"\'\\s]+)["\']?',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}',
    },
  ],
  packageRules: [
    {
      description: 'Auto-merge GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      automergeType: 'pr',
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      minimumReleaseAge: '3 days',
      ignoreTests: true,
    },
    {
      description: 'Auto-merge trusted GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      matchPackageNames: [
        '/^actions//',
        '/^anchore//',
        '/^docker//',
        '/^renovatebot//',
        '/^sigstore//',
      ],
      automerge: true,
      automergeType: 'pr',
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      minimumReleaseAge: '1 minute',
      ignoreTests: true,
    },
    {
      description: 'Auto-merge trusted Go modules',
      matchManagers: [
        'gomod',
      ],
      matchPackageNames: [
        '/^k8s\\.io\\//',
        '/^sigs\\.k8s\\.io\\//',
        '/^github\\.com\\/onsi\\//',
      ],
      automerge: true,
      automergeType: 'pr',
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      minimumReleaseAge: '3 days',
      ignoreTests: true,
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'type/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      labels: [
        'type/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      labels: [
        'type/patch',
      ],
    },
    {
      matchUpdateTypes: [
        'digest',
      ],
      labels: [
        'type/digest',
      ],
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      semanticCommitType: 'feat',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}})!:',
      commitMessageExtra: '({{currentVersion}} → {{newVersion}})',
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      semanticCommitType: 'feat',
      commitMessageExtra: '({{currentVersion}} → {{newVersion}})',
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      semanticCommitType: 'fix',
      commitMessageExtra: '({{currentVersion}} → {{newVersion}})',
    },
    {
      matchUpdateTypes: [
        'digest',
      ],
      semanticCommitType: 'fix',
      commitMessageExtra: '({{currentDigestShort}} → {{newDigestShort}})',
    },
    {
      matchDatasources: [
        'docker',
      ],
      semanticCommitScope: 'container',
      commitMessageTopic: 'image {{depName}}',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      semanticCommitType: 'ci',
      semanticCommitScope: 'github-action',
      commitMessageTopic: 'action {{depName}}',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}}):',
    },
    {
      matchManagers: [
        'gomod',
      ],
      semanticCommitType: 'chore',
      semanticCommitScope: 'deps',
      commitMessageTopic: 'module {{depName}}',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}}):',
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      semanticCommitType: 'chore',
      semanticCommitScope: 'github-release',
      commitMessageTopic: 'release {{depName}}',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}}):',
    },
    {
      description: 'Group every Go toolchain pin into a single update',
      matchDepNames: [
        'go',
        'golang',
      ],
      matchManagers: [
        'gomod',
        'mise',
        'dockerfile',
        'devcontainer',
      ],
      groupName: 'Go toolchain',
      groupSlug: 'go-toolchain',
      semanticCommitType: 'fix',
      semanticCommitScope: 'go',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}}):',
    },
    {
      description: 'Group golangci-lint across .mise/config.toml and .custom-gcl.yml',
      matchDepNames: [
        'golangci-lint',
        'golangci/golangci-lint',
      ],
      matchManagers: [
        'mise',
        'custom.regex',
      ],
      groupName: 'golangci-lint',
      groupSlug: 'golangci-lint',
      semanticCommitType: 'ci',
      semanticCommitScope: 'lint',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}}):',
    },
    {
      description: 'Hold structured-merge-diff major updates until k8s.io/apimachinery adopts them',
      matchManagers: [
        'gomod',
      ],
      matchPackageNames: [
        '/^sigs\\.k8s\\.io\\/structured-merge-diff\\//',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
  ],
}
